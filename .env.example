DEBUG=True
SECRET_KEY=your-secret-key-here

# Comma-separated hostnames/IPs the server answers to. With DEBUG=True, localhost
# is always allowed; add the machine's LAN IP to reach the dev server from another
# computer (run it with `python manage.py runserver 0.0.0.0:8000`).
# Required when DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=sofias
DB_USER=sofias
# The password you gave the database user (CREATE USER … WITH PASSWORD).
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=5432

# Email — defaults to console backend (prints to terminal) for local development.
# Switch to smtp for staging/production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@example.com
EMAIL_HOST_PASSWORD=yourpassword
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# OTP expiry in minutes (default: 10)
OTP_EXPIRY_MINUTES=10
