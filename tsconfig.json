{
  // IDE-level config. The browser build uses tsconfig.browser.json (npm run build:js).
  "compilerOptions": {
    // Environment
    "module": "nodenext",
    "target": "esnext",
    "types": [],

    // Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Typechecking
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  }
}
